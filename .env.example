# Neon Postgres (server only). Pooled for the app, direct for migrations and scripts.
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=

# Neon Auth (managed Better Auth). Google is configured in the Neon console.
NEON_AUTH_BASE_URL=
# At least 32 characters, for example: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Comma-separated Neon Auth user ids with admin access
ADMIN_USER_IDS=

R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_GATEWAY_URL=
R2_SIGNING_SECRET=
R2_PUBLIC_URL=

LOGOS_DIR=./logos-webp
DRY_RUN=false

# Retained only for backwards-compatible v1 administrative endpoints.
ADMIN_KEY=

NEXT_PUBLIC_SITE_URL=https://www.gsocorganizationsguide.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Only for the one-time move from the previous Supabase project (scripts/migrate-from-supabase.ts).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
