{
  "name": "gsoc-orgs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-organization-imports.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit && tsc -p cloudflare/tsconfig.json",
    "test": "vitest run",
    "supabase:bootstrap-admins": "tsx scripts/bootstrap-admins.ts",
    "supabase:import": "tsx scripts/import-supabase-catalog.ts",
    "supabase:import:dry-run": "tsx scripts/import-supabase-catalog.ts --dry-run",
    "supabase:verify-taxonomy": "tsx scripts/verify-taxonomy-normalization.ts",
    "supabase:import:mongo": "tsx scripts/import-legacy-mongo-export.ts",
    "supabase:reconcile": "tsx scripts/reconcile-supabase-catalog.ts",
    "supabase:types": "supabase gen types typescript --local --schema public,private > lib/supabase/database.types.ts",
    "supabase:types:linked": "supabase gen types typescript --linked --schema public,private > lib/supabase/database.types.ts",
    "validate": "npm run lint && npm run type-check && npm test && npm run supabase:import:dry-run && npm run build",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "r2:deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "r2:verify": "tsx scripts/verify-r2-gateway.ts",
    "postinstall": "node -e \"console.log('Supabase client requires no code generation')\"",
    "prepare": "husky",
    "generate:organizations": "tsx scripts/import-supabase-catalog.ts",
    "generate:organization-imports": "node scripts/generate-organization-imports.mjs",
    "generate:tech-stack": "tsx scripts/regenerate-tech-topics-from-json.ts",
    "generate:topics": "tsx scripts/regenerate-tech-topics-from-json.ts",
    "gsoc:fetch": "npx tsx scripts/fetch-year-data.ts",
    "gsoc:refresh": "npx tsx scripts/refresh-year.ts",
    "gsoc:verify-projects": "npx tsx scripts/verify-project-year-import.ts",
    "gsoc:refresh:commit": "npx tsx scripts/refresh-year.ts --commit",
    "gsoc:transform": "npx tsx scripts/transform-year-organizations.ts",
    "gsoc:yearly": "npx tsx scripts/generate-yearly-page-from-json.ts",
    "gsoc:regen": "npx tsx scripts/regenerate-tech-topics-from-json.ts",
    "gsoc:sync": "npx tsx scripts/fetch-year-data.ts && npx tsx scripts/transform-year-organizations.ts && npx tsx scripts/generate-yearly-page-from-json.ts && npx tsx scripts/regenerate-tech-topics-from-json.ts && npm run generate:organization-imports"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.11.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-list": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-subscript": "^3.27.1",
    "@tiptap/extension-superscript": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "fuse.js": "^7.4.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.555.0",
    "motion": "^12.23.24",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.6.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "2.15.4",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
