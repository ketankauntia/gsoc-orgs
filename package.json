{
  "name": "gsoc-orgs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-organization-imports.mjs && node scripts/generate-blog-sources.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit && tsc -p cloudflare/tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:status": "tsx scripts/db-migrate.ts --status",
    "db:import-catalog": "tsx scripts/import-catalog.ts",
    "db:import-catalog:dry-run": "tsx scripts/import-catalog.ts --dry-run",
    "db:reconcile": "tsx scripts/reconcile-catalog.ts",
    "db:verify-taxonomy": "tsx scripts/verify-taxonomy-normalization.ts",
    "db:migrate-from-supabase": "tsx scripts/migrate-from-supabase.ts",
    "validate": "npm run lint && npm run type-check && npm test && npm run db:import-catalog:dry-run && npm run build",
    "security:audit": "node scripts/audit-production.mjs",
    "r2:deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "r2:verify": "tsx scripts/verify-r2-gateway.ts",
    "prepare": "husky",
    "generate:organizations": "tsx scripts/import-catalog.ts",
    "generate:organization-imports": "node scripts/generate-organization-imports.mjs",
    "generate:tech-stack": "tsx scripts/regenerate-tech-topics-from-json.ts",
    "generate:topics": "tsx scripts/regenerate-tech-topics-from-json.ts",
    "gsoc:fetch": "npx tsx scripts/fetch-year-data.ts",
    "gsoc:refresh": "npx tsx scripts/refresh-year.ts",
    "gsoc:verify-projects": "npx tsx scripts/verify-project-year-import.ts",
    "gsoc:refresh:commit": "npx tsx scripts/refresh-year.ts --commit",
    "gsoc:transform": "npx tsx scripts/transform-year-organizations.ts",
    "gsoc:yearly": "npx tsx scripts/generate-yearly-page-from-json.ts",
    "gsoc:regen": "npx tsx scripts/regenerate-tech-topics-from-json.ts",
    "gsoc:sync": "npx tsx scripts/fetch-year-data.ts && npx tsx scripts/transform-year-organizations.ts && npx tsx scripts/generate-yearly-page-from-json.ts && npx tsx scripts/regenerate-tech-topics-from-json.ts && npm run generate:organization-imports && node scripts/generate-insights.mjs",
    "seo:indexnow": "tsx scripts/submit-indexnow.ts",
    "seo:indexnow:dry-run": "tsx scripts/submit-indexnow.ts --dry-run",
    "generate:insights": "node scripts/generate-insights.mjs",
    "predev": "node scripts/generate-blog-sources.mjs",
    "cf:build": "opennextjs-cloudflare build && node scripts/copy-catalog-assets.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/check-worker-env.mjs && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.11.1",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/extension-color": "^3.31.2",
    "@tiptap/extension-highlight": "^3.31.2",
    "@tiptap/extension-image": "^3.31.2",
    "@tiptap/extension-link": "^3.31.2",
    "@tiptap/extension-list": "^3.31.2",
    "@tiptap/extension-placeholder": "^3.31.2",
    "@tiptap/extension-subscript": "^3.31.2",
    "@tiptap/extension-superscript": "^3.31.2",
    "@tiptap/extension-table": "^3.31.2",
    "@tiptap/extension-table-cell": "^3.31.2",
    "@tiptap/extension-table-header": "^3.31.2",
    "@tiptap/extension-table-row": "^3.31.2",
    "@tiptap/extension-text-style": "^3.31.2",
    "@tiptap/pm": "^3.31.2",
    "@tiptap/react": "^3.31.2",
    "@tiptap/starter-kit": "^3.31.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "fuse.js": "^7.4.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.555.0",
    "motion": "^12.23.24",
    "next": "^16.4.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.6.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "2.15.4",
    "tailwind-merge": "^3.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "shadcn": "^4.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.157.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "fast-uri": "^3.1.9",
    "vite": "^8.2.4",
    "@neondatabase/auth": {
      "zod": "$zod"
    }
  }
}
